{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "随声练",
  "version": "0.1.0",
  "identifier": "io.github.aweiht.sing-practice",
  "build": {
    "frontendDist": "../ui/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "随声练",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "maximized": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/takes/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "跟着喜欢的歌曲练唱，查看音准",
    "copyright": "随声练基于 OnKey 开源项目，保留原项目 MIT 许可与版权声明。",
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "models/crepe-full-b32.onnx": "models/crepe-full-b32.onnx",
      "models/UVR_MDXNET_KARA_2.onnx": "models/UVR_MDXNET_KARA_2.onnx",
      "models/wav2vec2-base-960h-fp16.onnx": "models/wav2vec2-base-960h-fp16.onnx",
      "models/game/encoder.onnx": "models/game/encoder.onnx",
      "models/game/segmenter.onnx": "models/game/segmenter.onnx",
      "models/game/estimator.onnx": "models/game/estimator.onnx",
      "models/game/dur2bd.onnx": "models/game/dur2bd.onnx",
      "models/game/bd2dur.onnx": "models/game/bd2dur.onnx"
    }
  }
}
